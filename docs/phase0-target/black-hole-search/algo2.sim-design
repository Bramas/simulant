/-! Algorithm 2 of the black-hole-search paper (Three-Agent EBS Solution with one pebble):
a₁ marks its position with the pebble while it probes the next node; a₂ checks on a₁; a₃
follows a₂, or searches for the pebble when a₂ disappears. Target of
projects/black-hole-search/sim/algo2.sim (design file): `detection` is public for the one round
in which a₂ announces it, and a₂ and a₃ then walk cautiously counterclockwise. -/

import "std/models.sim"

algorithm ThreeAgentOnePebble uses otherStates, pebblesHere where
  Pub := { id : Nat, bh : Option Nat, detection : Bool }
  output claim := pub.bh
  init i := { pub := { id := i, bh := none, detection := false } }

  /-- The leader's side of the cautious walk (it does not announce a detection any more). -/
  def lead (dir : Nat) :=
    pub := { pub with detection := false }
    repeat
      move (port dir)
      move (port (Port.opposite dir))
      move (port dir)

  /-- The follower's side: wait for anyone to come back, or declare the hole. -/
  def follow (dir : Nat) :=
    repeat
      stay
      stay
      if otherStates.isEmpty then
        pub := { pub with bh := some dir }
        halt
      move (port dir)

  main :=
    if pub.id = 0 then
      move Ring.ccw
      repeat
        move Ring.cw with { pebble := .drop }
        if otherStates.isEmpty then
          pub := { pub with bh := some Port.cw }
          halt
        move Ring.ccw
        move Ring.cw with { pebble := .pick }
    else if pub.id = 1 then
      move Ring.cw
      repeat
        move Ring.ccw
        if otherStates.isEmpty then
          move Ring.cw
          pub := { pub with detection := true }
          move Ring.cw
          lead Port.ccw
        move Ring.cw
        move Ring.cw
    else
      move Ring.cw
      repeat
        if otherStates.isEmpty then
          move Ring.cw
          repeat
            if pebblesHere > 0 then
              pub := { pub with bh := some Port.cw }
              halt
            move Ring.cw
        if otherStates.any (·.detection) then
          follow Port.ccw
        move Ring.cw
        stay
        stay

/-- The settings of the paper's checks: cycles of 5 to 12 nodes, the hole anywhere. -/
experiment algo2 where
  model := blackHoleRobots (Graphs.Cycle N) .mayEmerge .unknown (extra := [Storage.Pebbles])
  algorithm := ThreeAgentOnePebble
  task := IdentifyEmergingBlackHole
  param N : Nat in (range 13).filter (· ≥ 5)
  param site : Pos in positions
  agents := 3
  position i := pos 0
