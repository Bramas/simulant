/-! Algorithm 3 of the black-hole-search paper (Three-Agent EBS Solution with the knowledge
of n): the roles traveler, next-traveler and waiter rotate; the traveler goes around the
cycle, the waiter checks that it comes back. Target of projects/black-hole-search/sim/algo3.sim
(design file): the traveler leads the cautious walk counterclockwise, and the waiter follows
it. The size is known through `spaceSize` (today's `ringSize`). -/

import "std/models.sim"

inductive Role | traveler | nextTraveler | waiter

algorithm ThreeAgentKnownN uses otherStates, spaceSize where
  Pub := { id : Nat, role : Role, bh : Option Nat }
  output claim := pub.bh
  init i := { pub := { id := i, role := if i = 0 then .traveler else if i = 1 then .nextTraveler else .waiter, bh := none } }

  /-- The traveler's side of the cautious walk: probe, come back, advance. -/
  def lead (dir : Nat) :=
    repeat
      move (port dir)
      move (port (Port.opposite dir))
      move (port dir)

  /-- The waiter's side: wait for the traveler to come back, or declare the hole. -/
  def follow (dir : Nat) :=
    repeat
      stay
      stay
      if !(otherStates.any (·.role = .traveler)) then
        pub := { pub with bh := some dir }
        halt
      move (port dir)

  main :=
    let k : Nat := 0
    if pub.role = .traveler then
      move Ring.cw
    else
      stay
    repeat
      if pub.role = .traveler then
        if !otherStates.isEmpty then
          lead Port.ccw
        k := 0
        while k < spaceSize - 2
          k := k + 1
          move Ring.cw
        if otherStates.isEmpty then
          pub := { pub with bh := some Port.cw }
          halt
        pub := { pub with role := .waiter }
        stay
      else if pub.role = .nextTraveler then
        wait spaceSize - 2
        pub := { pub with role := .traveler }
        stay
      else
        move Ring.ccw
        wait spaceSize - 3
        if otherStates.isEmpty then
          move Ring.cw
          follow Port.ccw
        pub := { pub with role := .nextTraveler }
        stay

/-- The settings of the paper's checks: cycles of 5 to 12 nodes, the hole anywhere. -/
experiment algo3 where
  model := blackHoleRobots (Graphs.Cycle N) .mayEmerge .known
  algorithm := ThreeAgentKnownN
  task := IdentifyEmergingBlackHole
  param N : Nat in (range 13).filter (· ≥ 5)
  param site : Pos in positions
  agents := 3
  position i := pos 0
