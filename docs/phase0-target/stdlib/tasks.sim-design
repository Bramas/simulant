/-! Library tasks (docs/core-redesign.md, section 7). Design file.

Tasks see the physical configuration. An answer given in an agent's own terms (a port) is
interpreted with the agent's kept frame: `C.resolve a i` is the neighbor of `a.pos` at the
agent's port i, and `C.follow a i k` the position reached by taking that port k times. Both are
errors under per-Look frames. A task that uses them is equivariant under the automorphisms that
the frames keep (section 7), which is what `@[equivariant]` claims for it: today's
`@[equivariant rotations]` on the black-hole tasks becomes plain `@[equivariant]`, because
`Frames.identity` keeps only the rotations of a cycle. -/

/-- Every correct agent claims the port leading to the black hole from its node (output
`claim : Option Nat`). Fails when no agent is correct. -/
@[equivariant]
task IdentifyBlackHole (C : Config) : Verdict :=
  let alive := C.agents.filter correct
  if alive.isEmpty then .failure
  else if alive.all fun a => a.claim.isSome ∧ C.resolve a (a.claim.getD 0) = C.world.site then .success
  else .inProgress

goal IdentifyBlackHole := eventually always .success

/-- Black-hole search with a hole that may emerge: once the hole is active, every correct
agent eventually claims the port leading to it, forever; an execution in which the hole never
activates succeeds (no fairness forces it to appear). Fails when no agent is correct. Reads the
output `claim : Option Nat`. -/
@[equivariant]
task IdentifyEmergingBlackHole (C : Config) : Verdict :=
  let alive := C.agents.filter correct
  if alive.isEmpty then .failure
  else if !C.world.active then .success
  else if alive.all fun a => a.claim.isSome ∧ C.resolve a (a.claim.getD 0) = C.world.site then .success
  else .inProgress

goal IdentifyEmergingBlackHole := eventually always .success

/-- As `IdentifyEmergingBlackHole`, for algorithms that locate the hole at any distance: the
outputs `claimPort : Option Nat` and `claimSteps : Nat` say that the hole is reached from the
agent by taking its port `claimPort` `claimSteps` times. -/
@[equivariant]
task IdentifyEmergingBlackHoleAt (C : Config) : Verdict :=
  let alive := C.agents.filter correct
  if alive.isEmpty then .failure
  else if !C.world.active then .success
  else if alive.all fun a => a.claimPort.isSome ∧ C.follow a (a.claimPort.getD 0) a.claimSteps = C.world.site then .success
  else .inProgress

goal IdentifyEmergingBlackHoleAt := eventually always .success

/-- Every present robot is on the same position, eventually. -/
@[equivariant]
task Gathering (C : Config) : Verdict :=
  let robots := C.agents.filter present
  if robots.all fun a => robots.all fun b => a.pos = b.pos then .success else .inProgress

goal Gathering := eventually .success

/-- Eventually, and forever, at most one present robot per position. -/
@[equivariant]
task Dispersion (C : Config) : Verdict :=
  let robots := C.agents.filter present
  if robots.all fun a => robots.count (fun b => b.pos = a.pos) = 1 then .success else .inProgress

goal Dispersion := eventually always .success

/-- Every position has been visited, eventually (finite spaces). Needs `Monitors.Visited`. -/
@[equivariant]
task Exploration (C : Config) : Verdict :=
  if C.positions.all fun p => C.world.visited.contains p then .success else .inProgress

goal Exploration := eventually .success
