/-! Algorithm 3 of A Visibility vs. Memory Trade-off for Stand-Up Indulgent
Gathering on Lines: two persistent colors X/Y, phi >= H_init, odd O_init or
odd M_init. All lights start X; Z denotes a node containing both X and Y.
Crashes may occur at crashNode after a light update and before movement.

Target of projects/standup-gathering/sim/two-colors.sim (design file): the rules are unchanged; they
read `lineView`/`colorView`, now built from locations (model.sim-design), and `move Ring.cw`
goes towards the larger indices of that view (`port 0`, the k > 0 side of `Line.window`). -/
import "./model.sim"

/-- The paper uses colors X and Y from the library's numeric palette. -/
def X : Nat := 0
def Y : Nat := 1

/-- Encode the generic color-set observation using the paper's X/Y/Z notation. -/
def paperView (colors : List (List Nat)) : List Nat :=
  colors.map fun here => (if here.contains X then 1 else 0) + (if here.contains Y then 2 else 0)

/-- Match a color set without reading outside the observed view: 1 = X!, 3 = Z. -/
def hasColor (v : List Nat) (i : Nat) (color : Nat) : Bool :=
  if i < v.length then v.at i = color else false

/-- X-in: the paper's guard in the displayed orientation. -/
def colorXIn (v : List Nat) : Bool :=
  let p := v.length / 2
  border v ∧ hasColor v p 1 ∧ empty v (p + 1) 1 ∧ nonempty v (p + 2) (p - 1)

/-- Z-in: the paper's guard in the displayed orientation. -/
def colorZIn (v : List Nat) : Bool :=
  let p := v.length / 2
  border v ∧ hasColor v p 3 ∧ empty v (p + 1) 1 ∧ nonempty v (p + 2) (p - 1)

/-- X-merge: the paper's guard in the displayed orientation. -/
def colorXMerge (v : List Nat) : Bool :=
  let p := v.length / 2
  border v ∧ hasColor v p 1 ∧ hasColor v (p + 1) 1

/-- Z-merge: the paper's guard in the displayed orientation. -/
def colorZMerge (v : List Nat) : Bool :=
  let p := v.length / 2
  border v ∧ hasColor v p 3 ∧ hasColor v (p + 1) 1

/-- final: the paper's guard in the displayed orientation. -/
def colorFinal (v : List Nat) : Bool :=
  let p := v.length / 2
  border v ∧ hasColor v p 1 ∧ hasColor v (p + 1) 3 ∧ empty v (p + 2) (p - 1)

/-- border-move: the paper's guard in the displayed orientation. -/
def colorBorderMove (v : List Nat) : Bool :=
  let p := v.length / 2
  border v ∧ nonempty v (p + 1) p

algorithm TwoColors uses colors where
  main :=
    let v := paperView colorView
    let vm := mirrored v
    -- X-in
    if colorXIn v then
      move Ring.cw
    else if colorXIn vm then
      move Ring.ccw
    -- Z-in
    else if colorZIn v then
      move Ring.cw
    else if colorZIn vm then
      move Ring.ccw
    -- X-merge
    else if colorXMerge v then
      move Ring.cw with { setLight := some Y }
    else if colorXMerge vm then
      move Ring.ccw with { setLight := some Y }
    -- Z-merge
    else if colorZMerge v then
      move Ring.cw with { setLight := some X }
    else if colorZMerge vm then
      move Ring.ccw with { setLight := some X }
    -- final
    else if colorFinal v ∨ colorFinal vm then
      stay with { setLight := some Y }
    -- border-move
    else if colorBorderMove v then
      move Ring.cw
    else if colorBorderMove vm then
      move Ring.ccw
    else
      stay

experiment twoColors where
  model := lineModel true
  algorithm := TwoColors
  task := Gathering
  param positions : List Int where admissiblePositions positions false
  param phi : Nat where phi ≥ requiredVisibility positions 0
  param crashNode : Pos
  agents := positions.length
  position i := pos (positions.at i)
  limits := { depth := 100, states := 20000 }
