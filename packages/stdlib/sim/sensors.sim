/-! Sensors expose an agent's observations to its algorithm.

A sensor receives the Look `L` and, for a per-location sensor, a location. Its result cannot
contain `Pos`, `Agent` or `Loc`. Choices are made once per Look, for the whole view (one sensor
environment per Look). A sensor that reads only the Look API is equivariant under every
automorphism of the space, since positions are opaque to it; no `@[equivariant]` claim is
needed. An algorithm can map a per-location sensor over the locations of its view. -/

/-- Is someone at this location? (weak multiplicity) -/
sensor occupied (L : Look) (l : Loc) : Bool :=
  (L.occupants l).any present

/-- How many agents are at this location (strong multiplicity). -/
sensor count (L : Look) (l : Loc) : Nat :=
  (L.occupants l).count present

/-- Multiplicity detection only where I stand: 0, 1 or 2 (two or more). -/
sensor localMultiplicity (L : Look) (l : Loc) : Nat :=
  min (if l = L.here then 2 else 1) ((L.occupants l).count present)

/-- The adversary may hide up to `k` agents of the whole view, once per Look. -/
@[implements occupied]
sensor lossyOccupied (k : Nat) (L : Look) where
  hidden := choose (subsetsUpTo k (L.visibleAgents.filter present))
    labels fun h => if h.isEmpty then "hides nobody" else "hides " ++ show h
  at (l : Loc) : Bool := (L.occupants l).any fun a => present a ∧ !hidden.contains a

/-- The colors present at this location, in palette order. Needs `Storage.Lights`.
Multiplicities and faults are not observable. -/
sensor colors (L : Look) (l : Loc) : List Nat :=
  (range L.world.colorCount).filter fun c => (L.occupants l).any fun a => present a ∧ a.light = c

/-- My own light. Needs `Storage.Lights`. -/
sensor ownLight (L : Look) : Nat :=
  L.me.light

/-- Public states of the other agents on my node. -/
sensor otherStates (L : Look) : Multiset Pub :=
  ((L.occupants L.here).filter fun b => b ≠ L.me ∧ present b).map (·.pub)

/-- The adversary may hide up to `k` of the agents on my node. A sensor without a location is
already evaluated once per Look, so its choice needs no separate Look-level part. -/
@[implements otherStates]
sensor otherStatesLossy (k : Nat) (L : Look) : Multiset Pub :=
  let seen := ((L.occupants L.here).filter fun b => b ≠ L.me ∧ present b).map (·.pub)
  let hidden := choose (subsetsUpTo k seen) labels fun h => if h.isEmpty then "hides nobody" else "hides " ++ show h
  seen.diff hidden

/-- Is the edge to this neighbor present this round? Dynamic spaces only. -/
sensor edgeTo (L : Look) (l : Loc) : Bool :=
  L.edgePresent L.here l

/-- The number of positions of a finite space, for models where agents know it. -/
sensor spaceSize (L : Look) : Nat :=
  L.spaceSize

-- `pebblesHere` belongs to `Storage.Pebbles` (components.sim).
