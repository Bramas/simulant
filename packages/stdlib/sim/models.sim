/-! Reusable models composed from independently configurable capabilities. -/

import "./sensors.sim"
import "./components.sim"

inductive SizeKnowledge | unknown | known

/-- The black-hole family: three hole policies, known or unknown size, any extra components. -/
def blackHoleRing (policy : HolePolicy) (size : SizeKnowledge) (extra : List Component := [])
    (topology : Topology := Ring) (view : Sensor := otherStates) (round : Round := .fsync) : Model where
  topology := topology
  sensors := [view] ++ (if size = .known then [ringSize] else [])
  components := [Hazards.BlackHole policy] ++ extra
  round := round

/-- Oblivious robots with configurable observations, orientation and topology. -/
def obliviousRing (topology : Topology := Ring) (view : Sensor := ringPresence)
    (frame : FrameModel := Frames.dynamicReflection) (components : List Component := [])
    (round : Round := .fsync) (symmetries : Symmetries := .derived) : Model where
  topology := topology
  sensors := [view]
  memory := .oblivious
  frame := frame
  components := components
  round := round
  symmetries := symmetries
