/-! Library components (plan, Section 3.5). "Hazards" and "faults" are namespaces, not
types: each is a component that owns state, raises flags, and reacts at the hook points
of the round. -/

inductive HolePolicy | none | initiallyPresent | mayEmerge

/-- A black hole at `param site`. In `afterMove` it chooses whether to activate (under
`mayEmerge`), and kills the present agents on its site. Once active, it stays active. -/
@[equivariant rotations reflections]
def Hazards.BlackHole (policy : HolePolicy) : Component where
  World := { site : Node, active : Bool }
  flags := [flag dead hidden, acts never]
  init := { site := param site, active := policy = .initiallyPresent }
  afterMove C :=
    let active :=
      if policy = .mayEmerge ∧ !C.world.active
      then choose [false, true] labels ["stays inactive", "activates"]
      else C.world.active
    { world := { C.world with active },
      raise dead := fun a => present a ∧ active ∧ a.pos = C.world.site }

/-- Up to `f` agents crash, at the start of any round. No counter: flags are never cleared. -/
@[equivariant rotations reflections]
def Faults.CrashStop (f : Nat) : Component where
  flags := [flag crashed visible, acts never]
  beforeLook C :=
    let S := choose (subsets (C.agents.filter correct))
      such that fun S => (C.agents.count (·.crashed)) + S.length ≤ f
      labels fun S => if S.isEmpty then "no crash" else "crash " ++ show S
    { raise crashed := S }

/-- Robots on the faulty node (`param crashNode`) may crash instead of executing their move. -/
@[equivariant rotations reflections]
def Faults.CrashAtNode : Component where
  World := { crashNode : Node }
  flags := [flag crashed visible, acts never]
  init := { crashNode := param crashNode }
  beforeMove C :=
    let S := choose (subsets (C.agents.filter fun a => correct a ∧ a.pos = C.world.crashNode))
      labels fun S => if S.isEmpty then "no crash" else "crash " ++ show S
    { raise crashed := S }

/-- A fixed visibility radius, supplied by `param phi`. Sensors choose what is
observable inside that radius; this component stores no robot state. -/
@[equivariant rotations reflections]
def Vision.Radius : Component where
  World := { phi : Nat }
  init := { phi := param phi }

/-- External lights with a fixed positive palette size. Color 0 is initial;
`light := none` keeps the color, and `some c` requests color c. Out-of-palette
requests are ignored. Slots are internal; this storage assumes no geometry,
visibility, population parameter or private algorithm memory. -/
@[equivariant rotations reflections]
def Storage.Lights (colors : Nat) : Component where
  World := { colorCount : Nat, lights : List Nat }
  Agent := { slot : Nat }
  actions := [action light : Option Nat := none]
  init := { colorCount := colors, lights := [] }
  init i := { slot := i }
  beforeMove C :=
    let lights := ofFn C.agents.length fun i =>
      let previous := if i < C.world.lights.length then C.world.lights.at i else 0
      let updates := C.agents.filter fun a => a.slot = i ∧ (decisionOf a).decided ∧
        (decisionOf a).light.isSome ∧ (decisionOf a).light.getD 0 < C.world.colorCount
      if updates.isEmpty then previous else (updates.map fun a => (decisionOf a).light.getD 0).sum
    { world := { C.world with lights } }

inductive PebbleAction | none | drop | pick

/-- Pebbles on nodes, one multiset entry per pebble. Dropping and picking are actions,
applied in `beforeMove`. All drops succeed; picks at a node succeed up to the number of
pebbles there (multiset difference is truncated). -/
@[equivariant rotations reflections]
def Storage.Pebbles : Component where
  World := { pebbles : Multiset Node }
  actions := [action pebble : PebbleAction := .none]
  sensors := [pebblesHere]
  init := { pebbles := [] }
  beforeMove C :=
    let picks := (C.agents.filter fun a => (decisionOf a).decided ∧ (decisionOf a).pebble = .pick).map (·.pos)
    let drops := (C.agents.filter fun a => (decisionOf a).decided ∧ (decisionOf a).pebble = .drop).map (·.pos)
    { world := { C.world with pebbles := (C.world.pebbles.diff picks) ++ drops } }

/-- The pebbles on my node. -/
@[equivariant rotations reflections]
sensor Storage.Pebbles.pebblesHere (C : Config) (me : Agent) : Nat :=
  C.world.pebbles.count (· = me.pos)

/-- Each agent has its own orientation, chosen at initialisation and fixed for the execution. -/
@[equivariant rotations reflections]
def Frames.PersistentReflection : Component where
  Agent := { mirrored : Frame }
  init i := { mirrored := choose frames labels fun f => "frame " ++ show f }

/-- The nodes visited so far, for tasks that depend on the history (temporary: plan
Section 8 puts history in the task's monitor). -/
@[equivariant rotations reflections]
def Monitors.Visited : Component where
  World := { visited : Multiset Node }
  init := { visited := [] }
  beforeLook C := { world := { C.world with visited := (C.world.visited ++ (C.agents.filter present).map (·.pos)).dedup } }
  afterMove C := { world := { C.world with visited := (C.world.visited ++ (C.agents.filter present).map (·.pos)).dedup } }
