/-! The IR conformance experiments (packages/engine/conformance), written in `.sim`.
A test checks that they give the same state graphs as the builder's versions. -/

import "./examples.sim"

/-- Agent 0 drops a pebble in the first round; in the second, every agent tries to pick one up. -/
algorithm PebbleTest uses pebblesHere where
  Pub := { id : Nat }
  Mem := { round : Nat }
  init i := { pub := { id := i }, mem := { round := 0 } }
  step mem pub :=
    { move := here, mem := { round := mem.round + 1 },
      pebble := if mem.round = 0 ∧ pub.id = 0 then .drop
        else if mem.round = 1 ∧ pebblesHere > 0 then .pick else .none }

/-- The distance from a location to the nearest of `others` (some of which are visible). -/
def nearest (from : Loc) (others : List Loc) : Nat :=
  ((range visible.length).filter fun k => others.any fun l => distance from l = k).at 0

/-- Oblivious robots with a full view: move to the neighbor closer to the nearest robot, stay on
a tie or when alone. -/
algorithm NearestNeighbour uses occupied where
  init i := {}
  step mem pub :=
    let others := visible.filter fun l => l ≠ here ∧ occupied l
    { move := if others.isEmpty then here else
        let d := nearest here others
        let closer := (neighbors here).filter fun n => nearest n others < d
        if closer.length = 1 then closer.at 0 else here }

/-- Oblivious robots that always move through their port 0. -/
algorithm AlwaysClockwise uses count where
  init i := {}
  step mem pub := { move := Ring.cw }

/-- Each agent records, in its public state, that it has been activated. -/
algorithm MarkActivated where
  Pub := { activated : Bool }
  init i := { pub := { activated := false } }
  step mem pub := { move := here, pub := { pub with activated := true } }

@[equivariant]
task EveryoneActivated (C : Config) : Verdict :=
  if C.agents.all (·.pub.activated) then .success else .inProgress

goal EveryoneActivated := eventually .success

/-- Never fails, never succeeds: for experiments that only look at the reachable configurations. -/
@[equivariant]
task Observe (C : Config) : Verdict := .inProgress

goal Observe := always ¬ .failure

/-- Agents on a cycle that see nothing, under a given scheduler. -/
def cycleRobots (scheduler : Scheduler) : Model :=
  obliviousRobots (Graphs.Cycle (param N)) (Observe.radius 1) Frames.identity [] (scheduler := scheduler)

experiment blackHoleEmerging where
  model := blackHoleSearch (Graphs.Cycle N) .mayEmerge .unknown
  algorithm := CautiousPair
  task := IdentifyBlackHole
  param N : Nat
  param site : Pos
  agents := 2
  position i := pos 0

experiment blackHoleCrashStop where
  model := blackHoleSearch (Graphs.Cycle N) .initiallyPresent .known (extra := [Faults.CrashStop 1])
  algorithm := CautiousPair
  task := IdentifyBlackHole
  param N : Nat
  param site : Pos
  agents := 2
  position i := pos 0

experiment blackHoleLossy where
  model := blackHoleSearch (Graphs.Cycle N) .initiallyPresent .unknown (view := otherStatesLossy 1)
  algorithm := CautiousPair
  task := IdentifyBlackHole
  param N : Nat
  param site : Pos
  agents := 2
  position i := pos 0

experiment pebbles where
  model := blackHoleSearch (Graphs.Cycle N) .none .unknown (extra := [Storage.Pebbles])
  algorithm := PebbleTest
  task := Observe
  param N : Nat
  param site : Pos
  agents := 2
  position i := pos 0

experiment gatheringRobots where
  model := obliviousRobots (Graphs.Cycle N) Observe.full Frames.isomorphisms [occupied] (components := [Faults.CrashAt])
  algorithm := NearestNeighbour
  task := Gathering
  param N : Nat
  param positions : List Pos
  param crashNode : Pos
  agents := positions.length
  position i := positions.at i

experiment dynamicRing where
  model := obliviousRobots (Graphs.Dynamic (Graphs.Cycle N) 1) (Observe.radius 1) Frames.identity [count]
    (components := [Monitors.Visited])
  algorithm := AlwaysClockwise
  task := Exploration
  param N : Nat
  param positions : List Pos
  agents := positions.length
  position i := positions.at i

/-- Each robot keeps its own orientation: its port 0 is either side, chosen once. -/
experiment ownOrientation where
  model := obliviousRobots (Graphs.Cycle N) (Observe.radius 1) (Frames.portPermutations .perRobot) [count]
    (components := [Monitors.Visited])
  algorithm := AlwaysClockwise
  task := Exploration
  param N : Nat
  param positions : List Pos
  agents := positions.length
  position i := positions.at i

/-- A fresh orientation at each Look, among the symmetries of the cycle. -/
experiment portPermutations where
  model := obliviousRobots (Graphs.Cycle N) (Observe.radius 1) (Frames.portPermutations .perLook (among := .symmetries)) [count]
    (components := [Monitors.Visited])
  algorithm := AlwaysClockwise
  task := Exploration
  param N : Nat
  param positions : List Pos
  agents := positions.length
  position i := positions.at i

experiment ssync where
  model := cycleRobots Schedulers.SSync
  algorithm := MarkActivated
  task := EveryoneActivated
  param N : Nat
  agents := 3
  position i := pos i

experiment sequential where
  model := cycleRobots Schedulers.Sequential
  algorithm := MarkActivated
  task := EveryoneActivated
  param N : Nat
  agents := 3
  position i := pos i

/-- A predicate-only domain accepts arbitrary cycle sizes satisfying its bound. -/
experiment parameterAcceptance where
  model := cycleRobots Schedulers.Sequential
  algorithm := MarkActivated
  task := EveryoneActivated
  param N : Nat where N ≥ 3
  agents := 3
  position i := pos i

/-- Exercise a three-color palette, color-set observations, fixed-node crashes and the line. -/
algorithm CycleLight uses colors where
  init i := {}
  step mem pub := { move := Ring.cw, setLight := some (((colors here).sum + 1) % 3) }

experiment lights where
  model := obliviousRobots Graphs.Line (Observe.radius phi) Frames.isomorphisms [colors]
    (components := [Storage.Lights 3, Faults.CrashAt])
  algorithm := CycleLight
  task := Observe
  param positions : List Int
  param phi : Nat
  param crashNode : Pos
  agents := positions.length
  position i := pos (positions.at i)

/-- Agents with lights on a cycle, under a given scheduler: a decision's light shows at its
Compute, and a Look at that instant still sees the previous light. -/
def lightsOnCycle (scheduler : Scheduler) : Model :=
  obliviousRobots (Graphs.Cycle (param N)) (Observe.radius 1) Frames.identity [colors]
    (components := [Storage.Lights 3]) (scheduler := scheduler)

experiment asyncLights where
  model := lightsOnCycle Schedulers.Async
  algorithm := CycleLight
  task := Observe
  param N : Nat
  agents := 2
  position i := pos i

experiment lcAtomicLights where
  model := lightsOnCycle (Schedulers.Async [[.look, .compute], [.move]])
  algorithm := CycleLight
  task := Observe
  param N : Nat
  agents := 2
  position i := pos i

experiment cmAtomicLights where
  model := lightsOnCycle (Schedulers.Async [[.look], [.compute, .move]])
  algorithm := CycleLight
  task := Observe
  param N : Nat
  agents := 2
  position i := pos i

experiment bounded where
  model := cycleRobots (Schedulers.Bounded 2)
  algorithm := MarkActivated
  task := EveryoneActivated
  param N : Nat
  agents := 3
  position i := pos i

experiment permutation where
  model := cycleRobots Schedulers.Permutation
  algorithm := MarkActivated
  task := EveryoneActivated
  param N : Nat
  agents := 3
  position i := pos i

/-- Robots on leaves move to the center; robots at the center stay. -/
algorithm ToHub uses occupied where
  main :=
    if (neighbors here).length = 1 then move ((neighbors here).at 0) else stay

experiment starGathering where
  model := obliviousRobots (Graphs.Star k) (Observe.radius 1) Frames.isomorphisms [occupied]
  algorithm := ToHub
  task := Gathering
  param k : Nat
  param start : List Nat
  agents := start.length
  position i := pos (start.at i)

/-- Dispersion on any graph: leave a crowded node for an empty neighbor. -/
algorithm Disperse uses count where
  main :=
    let free := (neighbors here).filter fun l => count l = 0
    if count here > 1 ∧ !free.isEmpty then move (free.at 0) else stay

experiment starDispersion where
  model := obliviousRobots (Graphs.Star k) (Observe.radius 1) Frames.isomorphisms [count]
  algorithm := Disperse
  task := Dispersion
  param k : Nat
  agents := 3
  position i := pos 0

/-- Two fields whose concatenations agree, but whose configurations must stay distinct. -/
def FieldChoices : Component where
  Agent := { x : Nat, y : Nat }
  init i := { x := 0, y := 0 }
  beforeLook C :=
    let b := choose [false, true]
    { agents := fun a => { x := if b then 12 else 1, y := if b then 3 else 23 } }

algorithm Stay where
  init i := {}
  step mem pub := { move := here }

task SafeFields (C : Config) : Verdict :=
  if C.agents.any (fun a => a.x = 12) then .failure else .inProgress

goal SafeFields := always ¬ .failure

experiment agentFields where
  model := obliviousRobots (Graphs.Cycle N) (Observe.radius 1) Frames.identity []
    (components := [FieldChoices]) (symmetries := .none)
  algorithm := Stay
  task := SafeFields
  param N : Nat
  agents := 1
  position i := pos 0

/-- Record edges to all locations, including here and locations that are not neighbors. -/
algorithm ReadEdges uses edgeTo where
  Pub := { edges : List Bool }
  init i := { pub := { edges := [] } }
  step mem pub := { move := here, pub := { edges := visible.map edgeTo } }

experiment edgePresence where
  model := obliviousRobots (Graphs.Dynamic (Graphs.Cycle N) 1) (Observe.radius 2) Frames.identity [edgeTo]
  algorithm := ReadEdges
  task := Observe
  param N : Nat
  agents := 1
  position i := pos 0
