/-! Small algorithms and experiments, used by tests and as examples of the language.
They are not paper algorithms. -/

import "./models.sim"
import "./tasks.sim"

inductive PC | probe | back | advance | wait1 | wait2 | check | halted

/-- A cautious walk of two agents: agent 0 probes its clockwise neighbor and comes back; agent 1
waits, and claims the hole behind its clockwise port if agent 0 does not come back. Written as
an explicit state machine; `Ring.cw` and `here` are locations of the agent's Look. -/
algorithm CautiousPair uses otherStates where
  Pub := { id : Nat, bh : Option Nat }
  Mem := { pc : PC }
  output claim := pub.bh
  init i := { pub := { id := i, bh := none }, mem := { pc := if i = 0 then .probe else .wait1 } }
  step mem pub :=
    match mem.pc with
    | .probe => { move := Ring.cw, mem := { pc := .back } }
    | .back => { move := Ring.ccw, mem := { pc := .advance } }
    | .advance => { move := Ring.cw, mem := { pc := .probe } }
    | .wait1 => { move := here, mem := { pc := .wait2 } }
    | .wait2 => { move := here, mem := { pc := .check } }
    | .check =>
      if otherStates.any (·.id = 0) then { move := Ring.cw, mem := { pc := .wait1 } }
      else { move := here, pub := { pub with bh := some Port.cw }, mem := { pc := .halted } }
    | .halted => { move := here }
  line mem :=
    match mem.pc with
    | .probe => 3 | .back => 4 | .advance => 5 | .wait1 => 8 | .wait2 => 9 | .check => 10 | .halted => 12

/-- The cautious pair, with a hole present from the start, on cycles of 3 to 6 nodes. -/
experiment cautiousPair where
  model := blackHoleRobots (Graphs.Cycle N) .initiallyPresent .unknown
  algorithm := CautiousPair
  task := IdentifyBlackHole
  param N : Nat := (range 7).filter (· ≥ 3)
  param site : Pos := ((range N).filter (· ≥ 1)).map pos
  agents := 2
  position i := pos 0

/-- The same algorithm with an emerging hole, crashes, and unrelated state (pebbles). -/
experiment cautiousPairCrash where
  model := blackHoleRobots (Graphs.Cycle N) .mayEmerge .known (extra := [Faults.CrashStop 1, Storage.Pebbles])
  algorithm := CautiousPair
  task := IdentifyBlackHole
  param N : Nat := (range 7).filter (· ≥ 3)
  param site : Pos := ((range N).filter (· ≥ 1)).map pos
  agents := 2
  position i := pos 0
