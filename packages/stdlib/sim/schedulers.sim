/-! Schedulers choose, at each step, the agents that take the next event of their cycle
(docs/scheduler-design.md).

A scheduler may own world and agent fields, like a component. Its `schedule C` hook returns an
effect whose `activate` part lists the agents that take their next event; its other parts update
the scheduler's own fields. `events` cuts the Look-Compute-Move cycle into atomic events (one
whole cycle by default), and `fairness` says which executions count (`.activation` by default:
every agent that keeps acting takes events infinitely often). A step in which no agent can act
idles without asking the scheduler. -/

/-- Every agent able to act, every step: fully synchronous rounds (FSYNC). -/
@[equivariant]
def Schedulers.FSync : Scheduler where
  fairness := .none
  schedule C := { activate := C.eligible }

/-- A nonempty set of the agents able to act, chosen by the adversary at each step:
semi-synchronous rounds (SSYNC). -/
@[equivariant]
def Schedulers.SSync : Scheduler where
  schedule C :=
    let S := choose (nonemptySubsets C.eligible) labels fun S => "activates " ++ show S
    { activate := S }

/-- One agent able to act, chosen by the adversary at each step. -/
@[equivariant]
def Schedulers.Sequential : Scheduler where
  schedule C :=
    let a := choose C.eligible labels fun a => "activates " ++ show a
    { activate := fun b => b = a }
