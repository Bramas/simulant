{
  "name": "@bramas/simulant-core",
  "version": "0.2.0",
  "private": false,
  "license": "CECILL-B",
  "type": "module",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "exports": {
    "./lib/*": {
      "types": "./src/lib/*.ts",
      "default": "./dist/lib/*.js"
    },
    "./types/*": {
      "types": "./src/types/*.ts",
      "default": "./dist/types/*.js"
    }
  },
  "files": [
    "src",
    "dist",
    "LICENCE.txt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bramas/simulant.git",
    "directory": "packages/core"
  }
}
