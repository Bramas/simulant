{
  "name": "@bramas/simulant-ui",
  "version": "0.4.0",
  "private": false,
  "license": "CECILL-B",
  "type": "module",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "exports": {
    "./SimulatorApp": {
      "types": "./src/SimulatorApp.tsx",
      "solid": "./dist/SimulatorApp.jsx",
      "default": "./dist/SimulatorApp.jsx"
    },
    "./simulator.css": "./src/simulator.css",
    "./pico.min.css": "./src/pico.min.css",
    "./components/*": {
      "types": "./src/components/*.tsx",
      "solid": "./dist/components/*.jsx",
      "default": "./dist/components/*.jsx"
    },
    "./sim/*": {
      "types": "./src/sim/*.ts",
      "default": "./dist/sim/*.js"
    },
    "./renderers/*": {
      "types": "./src/renderers/*.ts",
      "default": "./dist/renderers/*.js"
    }
  },
  "dependencies": {
    "@bramas/simulant-core": "workspace:*",
    "@bramas/simulant-lang": "workspace:*",
    "@bramas/simulant-engine": "workspace:*",
    "@bramas/simulant-lean-gen": "workspace:*",
    "@bramas/simulant-vite-plugin": "workspace:*"
  },
  "peerDependencies": {
    "solid-js": "^1.9.3"
  },
  "files": [
    "src",
    "dist",
    "LICENCE.txt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bramas/simulant.git",
    "directory": "packages/simulator-ui"
  }
}
