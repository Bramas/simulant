{
  "name": "@bramas/simulant-lean-gen",
  "version": "0.1.2",
  "private": false,
  "license": "CECILL-B",
  "type": "module",
  "dependencies": {
    "@bramas/simulant-lang": "workspace:*",
    "@bramas/simulant-engine": "workspace:*"
  },
  "exports": {
    "./check-proofs": {
      "types": "./src/check-proofs.ts",
      "default": "./dist/check-proofs.js"
    },
    "./component": {
      "types": "./src/component.ts",
      "default": "./dist/component.js"
    },
    "./differential": {
      "types": "./src/differential.ts",
      "default": "./dist/differential.js"
    },
    "./library": {
      "types": "./src/library.ts",
      "default": "./dist/library.js"
    },
    "./model": {
      "types": "./src/model.ts",
      "default": "./dist/model.js"
    },
    "./names": {
      "types": "./src/names.ts",
      "default": "./dist/names.js"
    },
    "./translate": {
      "types": "./src/translate.ts",
      "default": "./dist/translate.js"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "src",
    "dist",
    "!src/examples.ts",
    "!dist/examples.js",
    "LICENCE.txt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bramas/simulant.git",
    "directory": "packages/lean-gen"
  }
}
