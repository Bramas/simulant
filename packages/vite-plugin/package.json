    },
    "./bun-register": "./dist/bun-register.mjs",
    "./sim.d.ts": "./sim.d.ts"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "src",
    "dist",
    "sim.d.ts",
    "LICENCE.txt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bramas/simulant.git",
    "directory": "packages/vite-plugin"
  }
}
