{
  "name": "@bramas/simulant-vite-plugin",
  "version": "0.4.0",
  "private": false,
  "license": "CECILL-B",
  "type": "module",
  "dependencies": {
    "@bramas/simulant-lang": "workspace:*",
    "@bramas/simulant-lean-gen": "workspace:*"
  },
  "peerDependencies": {
    "vite": "^6.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./src/*.ts",
