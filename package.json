{
  "name": "simulant-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "extensions/*",
    "projects/*",
    "projects/private/*"
  ],
  "scripts": {
    "start": "pnpm --filter @bramas/simulant-project-starter dev",
    "dev": "pnpm --filter @bramas/simulant-project-starter dev",
    "build": "node scripts/build-public-site.mjs",
    "serve": "pnpm --filter @bramas/simulant-project-starter serve",
    "check": "node packages/cli/bin/simulant.mjs check",
    "cli": "node packages/cli/bin/simulant.mjs",
    "typecheck": "tsx scripts/sim-types.ts && tsc --noEmit",
    "test": "node --import tsx --import ./packages/vite-plugin/src/register.ts --test --test-isolation=none tests/*.test.ts packages/*/test/*.test.ts apps/*/test/*.test.ts extensions/*/test/*.test.ts",
    "editor:build": "pnpm --filter simulant build",
    "editor:package": "pnpm --filter simulant package",
    "sim-types": "tsx scripts/sim-types.ts",
    "test:browser": "node --import tsx --test --test-isolation=none --test-concurrency=1 tests/browser/*.test.ts"
  },
  "license": "CECILL-B",
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.7.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.11.0",
    "@bramas/simulant-cli": "workspace:*"
  },
  "dependencies": {
    "solid-js": "^1.9.3"
  }
}
