{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "packages/*/src",
    "extensions/*/src",
    "packages/stdlib/test/helpers",
    "projects/black-hole-search/src",
    "projects/black-hole-search/web",
    "projects/starter/src",
    "projects/starter/web",
    "apps/public-site",
    "scripts",
    "tests",
    "apps/preview/src",
    "packages/vite-plugin/sim.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "projects/private"
  ]
}
