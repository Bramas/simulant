/-! A Visibility vs. Memory Trade-off for Stand-Up Indulgent Gathering on Lines.

FSYNC, anonymous disoriented robots, no multiplicity detection, and crashes at
one location. A padded ring encodes the finite occupied interval of the infinite
line. Sensors expose only a radius-phi view; no robot learns its identity,
the population, crash status, or the size of the finite encoding. -/

/-- At either phase the adversary may crash any colocated subset. Once a crash
has occurred, the visible, immobile crashed robots fix the only allowed site.
Choosing the empty subset at every round gives a fault-free execution. -/
def SingleLocationCrashes : Component where
  flags := [flag crashed visible, acts never]
  beforeLook C :=
    let S := choose (subsets (C.agents.filter correct))
      such that fun S => S.all (fun a => S.all (fun b => a.pos = b.pos) ∧ C.agents.all (fun b => !b.crashed ∨ a.pos = b.pos))
      labels fun S => if S.isEmpty then "no crash before Look" else "crash before Look: " ++ show S
    { raise crashed := S }
  beforeMove C :=
    let S := choose (subsets (C.agents.filter correct))
      such that fun S => S.all (fun a => S.all (fun b => a.pos = b.pos) ∧ C.agents.all (fun b => !b.crashed ∨ a.pos = b.pos))
      labels fun S => if S.isEmpty then "no crash after Compute" else "crash after Compute: " ++ show S
    { raise crashed := S }

/-- The oblivious algorithms have occupancy detection and no light storage. -/
def LineRobots : Component where
  World := { initialPositions : List Nat, phi : Nat }
  sensors := [lineView]
  init := { initialPositions := param positions, phi := param phi }

/-- One bit per visible node: 0 is empty and 1 is occupied, regardless of multiplicity. -/
sensor LineRobots.lineView (C : Config) (me : Agent) (frame : Frame) : List Nat :=
  ofFn (2 * C.world.phi + 1) fun i =>
    let p := offset me.pos frame ((C.size + i - C.world.phi) % C.size)
    if C.agents.any (fun a => present a ∧ a.pos = p) then 1 else 0

inductive LightUpdate | keep | x | y

/-- Every external light starts at X (false). Slots associate lights with robots
inside the simulator and are never sensed. Committing colors before movement
preserves the new light when a crash stops the subsequent atomic move. -/
def LuminousRobots : Component where
  World := { initialPositions : List Nat, phi : Nat, lights : List Bool }
  Agent := { slot : Nat }
  actions := [action light : LightUpdate := .keep]
  sensors := [lineView]
  init := { initialPositions := param positions, phi := param phi,
            lights := (param positions).map (fun p => false) }
  init i := { slot := i }
  beforeMove C :=
    let lights := ofFn C.world.lights.length fun i =>
      if C.agents.any (fun a => a.slot = i ∧ (decisionOf a).decided ∧ (decisionOf a).light = .y) then true
      else if C.agents.any (fun a => a.slot = i ∧ (decisionOf a).decided ∧ (decisionOf a).light = .x) then false
      else C.world.lights.at i
    { world := { C.world with lights } }

/-- Color sets: 0 = empty, 1 = X only, 2 = Y only, 3 = Z (X and Y).
Equal-colored multiplicities are indistinguishable. -/
sensor LuminousRobots.lineView (C : Config) (me : Agent) (frame : Frame) : List Nat :=
  ofFn (2 * C.world.phi + 1) fun i =>
    let p := offset me.pos frame ((C.size + i - C.world.phi) % C.size)
    let x := C.agents.any fun a => present a ∧ a.pos = p ∧ !C.world.lights.at a.slot
    let y := C.agents.any fun a => present a ∧ a.pos = p ∧ C.world.lights.at a.slot
    (if x then 1 else 0) + (if y then 2 else 0)

/-- No private memory in either variant; only the luminous variant has external lights. -/
def lineModel (luminous : Bool := false) : Model where
  topology := Ring
  round := .fsync
  frame := Frames.dynamicReflection
  memory := .oblivious
  components := [if luminous then LuminousRobots else LineRobots, SingleLocationCrashes]
  symmetries := .none

/-- SUIG includes crashed robots and requires permanent gathering. -/
task StandUpGathering (C : Config) : Verdict :=
  if C.agents.all (fun a => C.agents.all (fun b => a.pos = b.pos)) then .success else .inProgress

goal StandUpGathering := eventually always .success

/-- Reflect a view, leaving the observing robot at its center. -/
def mirrored (v : List Nat) : List Nat :=
  ofFn v.length fun i => v.at (v.length - 1 - i)

/-- A guard cannot match an occupied or empty node outside the observed view.
This also keeps exploration below the declared visibility bounds executable. -/
def occupied (v : List Nat) (i : Nat) : Bool :=
  if i < v.length then v.at i > 0 else false

def empty (v : List Nat) (start : Nat) (count : Nat) : Bool :=
  if start + count ≤ v.length then (range count).all (fun i => v.at (start + i) = 0) else false

def nonempty (v : List Nat) (start : Nat) (count : Nat) : Bool :=
  (range count).any fun i => occupied v (start + i)

/-- Rule priority applies across both orientations, including idle rules.
Equal matching priorities let the adversary's local frame pick the direction. -/
def priority (a : Nat) (b : Nat) : Nat :=
  if a = 0 then b else if b = 0 then a else min a b

/-- Maximum neighboring distance, computed only for initial-domain assumptions.
The coordinates are sorted and can contain multiplicities. -/
def initialHole (ps : List Nat) : Nat :=
  let gaps := ofFn ps.length fun i => if i = 0 then 0 else ps.at i - ps.at (i - 1)
  (gaps.filter fun h => gaps.all (· ≤ h)).at 0

/-- The paper counts occupied nodes, not robots: multiplicities do not change O_init.
Odd M_init is equivalent to an even distance between the borders. -/
def admissiblePositions (ps : List Nat) (oddOnly : Bool) : Bool :=
  ps.length ≥ 2 ∧
  (range ps.length).all (fun i => i = 0 ∨ ps.at (i - 1) ≤ ps.at i) ∧
  (ps.dedup.length % 2 = 1 ∨ (!oddOnly ∧ (ps.at (ps.length - 1) - ps.at 0) % 2 = 0))

/-- Required visibility for these coordinates: max(4, H_init + extra) for
oblivious robots, and max(1, H_init) for the two-color algorithm (extra = 0). -/
def requiredVisibility (ps : List Nat) (extra : Nat) : Nat :=
  max (if extra = 0 then 1 else 4) (initialHole ps + extra)

/-- Enough empty padding to make every radius-phi observation a line observation. -/
def fitsLine (N : Nat) (ps : List Nat) (phi : Nat) : Bool :=
  N ≥ ps.at (ps.length - 1) + 2 * phi + 3
