/-! Algorithm 1 of A Visibility vs. Memory Trade-off for Stand-Up Indulgent
Gathering on Lines: oblivious robots, phi >= H_init + 3 (phi >= 4), and odd
O_init or odd M_init. Rules below follow the paper's decreasing priorities.

The rules read `lineView` or `colorView`, the radius-phi window from one end to the other
(model.sim); `move Ring.cw` goes towards the larger indices of that window. -/
import "./model.sim"

/-- phi4: the paper's guard in the displayed orientation. -/
def h3Phi4 (v : List Nat) : Bool :=
  let p := v.length / 2
  p = 4 ∧ nonempty v 0 p ∧ nonempty v (p + 1) p

/-- wait: the paper's guard in the displayed orientation. -/
def h3Wait (v : List Nat) : Bool :=
  let p := v.length / 2
  border v ∧ empty v (p + 1) 1 ∧ occupiedAt v (p + 2) ∧ occupiedAt v (p + 3) ∧ empty v (p + 4) (p - 3)

/-- neig, move, 1: the paper's guard in the displayed orientation. -/
def h3NeighborMove1 (v : List Nat) : Bool :=
  let p := v.length / 2
  borderNeighbor v ∧ empty v (p + 1) 1 ∧ nonempty v (p + 2) (p - 1)

/-- 2neig, move: the paper's guard in the displayed orientation. -/
def h3SecondNeighborMove (v : List Nat) : Bool :=
  let p := v.length / 2
  secondBorderNeighbor v ∧ empty v (p + 1) 2 ∧ nonempty v (p + 3) (p - 2)

/-- sym,1: the paper's guard in the displayed orientation. -/
def h3Symmetric1 (v : List Nat) : Bool :=
  let p := v.length / 2
  border v ∧ occupiedAt v (p + 1) ∧ occupiedAt v (p + 2) ∧ occupiedAt v (p + 3) ∧ empty v (p + 4) (p - 3)

/-- false-wait: the paper's guard in the displayed orientation. -/
def h3FalseWait (v : List Nat) : Bool :=
  let p := v.length / 2
  p = 5 ∧ empty v 0 (p - 2) ∧ occupiedAt v (p - 2) ∧ empty v (p - 1) 1 ∧ occupiedAt v (p + 1) ∧ empty v (p + 2) 2 ∧ occupiedAt v (p + 4) ∧ empty v (p + 5) 1

/-- false-sym,1: the paper's guard in the displayed orientation. -/
def h3FalseSymmetric1 (v : List Nat) : Bool :=
  let p := v.length / 2
  p = 5 ∧ borderNeighbor v ∧ occupiedAt v (p + 1) ∧ occupiedAt v (p + 2) ∧ empty v (p + 3) 2 ∧ occupiedAt v (p + 5)

/-- false-sym,2: the paper's guard in the displayed orientation. -/
def h3FalseSymmetric2 (v : List Nat) : Bool :=
  let p := v.length / 2
  p = 5 ∧ secondBorderNeighbor v ∧ occupiedAt v (p + 1) ∧ empty v (p + 2) 2 ∧ occupiedAt v (p + 4) ∧ empty v (p + 5) 1

/-- border: the paper's guard in the displayed orientation. -/
def h3Border (v : List Nat) : Bool :=
  let p := v.length / 2
  border v ∧ nonempty v (p + 1) p

/-- neig, move, 2: the paper's guard in the displayed orientation. -/
def h3NeighborMove2 (v : List Nat) : Bool :=
  let p := v.length / 2
  borderNeighbor v ∧ occupiedAt v (p + 1) ∧ empty v (p + 2) 2 ∧ nonempty v (p + 4) (p - 3)

/-- sym,2: the paper's guard in the displayed orientation. -/
def h3Symmetric2 (v : List Nat) : Bool :=
  let p := v.length / 2
  borderNeighbor v ∧ occupiedAt v (p + 1) ∧ occupiedAt v (p + 2) ∧ empty v (p + 3) (p - 2)

/-- 2neig, merge: the paper's guard in the displayed orientation. -/
def h3SecondNeighborMerge (v : List Nat) : Bool :=
  secondBorderNeighbor v

algorithm ObliviousHPlusThree uses occupied where
  main :=
    let v := lineView
    let vm := mirrored v
    -- phi4
    if h3Phi4 v ∨ h3Phi4 vm then
      stay
    -- wait
    else if h3Wait v ∨ h3Wait vm then
      stay
    -- neig, move, 1
    else if h3NeighborMove1 v then
      move Ring.cw
    else if h3NeighborMove1 vm then
      move Ring.ccw
    -- 2neig, move
    else if h3SecondNeighborMove v then
      move Ring.cw
    else if h3SecondNeighborMove vm then
      move Ring.ccw
    -- sym,1
    else if h3Symmetric1 v ∨ h3Symmetric1 vm then
      stay
    -- false-wait
    else if h3FalseWait v then
      move Ring.cw
    else if h3FalseWait vm then
      move Ring.ccw
    -- false-sym,1
    else if h3FalseSymmetric1 v then
      move Ring.ccw
    else if h3FalseSymmetric1 vm then
      move Ring.cw
    -- false-sym,2
    else if h3FalseSymmetric2 v then
      move Ring.cw
    else if h3FalseSymmetric2 vm then
      move Ring.ccw
    -- border
    else if h3Border v then
      move Ring.cw
    else if h3Border vm then
      move Ring.ccw
    -- neig, move, 2
    else if h3NeighborMove2 v then
      move Ring.cw
    else if h3NeighborMove2 vm then
      move Ring.ccw
    -- sym,2
    else if h3Symmetric2 v then
      move Ring.ccw
    else if h3Symmetric2 vm then
      move Ring.cw
    -- 2neig, merge
    else if h3SecondNeighborMerge v then
      move Ring.ccw
    else if h3SecondNeighborMerge vm then
      move Ring.cw
    else
      stay

experiment hPlusThree where
  model := lineModel
  algorithm := ObliviousHPlusThree
  task := Gathering
  param positions : List Int where admissiblePositions positions false
  param phi : Nat where phi ≥ requiredVisibility positions 3
  param crashNode : Pos
  agents := positions.length
  position i := pos (positions.at i)
  limits := { depth := 100, states := 20000 }
