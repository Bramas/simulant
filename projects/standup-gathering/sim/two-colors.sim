/-! Algorithm 3 of A Visibility vs. Memory Trade-off for Stand-Up Indulgent
Gathering on Lines: two persistent colors X/Y, phi >= H_init, odd O_init or
odd M_init. All lights start X; Z denotes a node containing both X and Y.
Crashes may occur before Look or after a light update but before movement. -/
import "./model.sim"

/-- The six guards of Algorithm 3. Color sets are 1 = X!, 2 = Y!, 3 = Z. -/
def colorRule (v : List Nat) : Nat :=
  let p := v.length / 2
  let border := empty v 0 p
  if p = 0 then 0 -- No directional guard is observable with radius zero.
  else if border ∧ v.at p = 1 ∧ empty v (p + 1) 1 ∧ nonempty v (p + 2) (p - 1) then 1 -- X-in
  else if border ∧ v.at p = 3 ∧ empty v (p + 1) 1 ∧ nonempty v (p + 2) (p - 1) then 2 -- Z-in
  else if border ∧ v.at p = 1 ∧ v.at (p + 1) = 1 then 3 -- X-merge: Y, right
  else if border ∧ v.at p = 3 ∧ v.at (p + 1) = 1 then 4 -- Z-merge: X, right
  else if border ∧ v.at p = 1 ∧ v.at (p + 1) = 3 ∧ empty v (p + 2) (p - 1) then 5 -- final: Y, idle
  else if border ∧ nonempty v (p + 1) p then 6 -- border-move
  else 0

algorithm TwoColors uses lineView where
  init i := {}
  step mem pub view :=
    let a := colorRule view.lineView
    let b := colorRule (mirrored view.lineView)
    let r := priority a b
    let inward := if r = a then .cw else .ccw
    if r = 0 then { move := .stay }
    else if r = 3 then { move := inward, light := .y }
    else if r = 4 then { move := inward, light := .x }
    else if r = 5 then { move := .stay, light := .y }
    else { move := inward }

experiment twoColors where
  model := lineModel true
  algorithm := TwoColors
  task := StandUpGathering
  param N : Nat where N ≥ 3
  param positions : List Nat where admissiblePositions positions false
  param phi : Nat where phi ≥ requiredVisibility positions 0 ∧ fitsLine N positions phi
  agents := positions.length
  position i := node (phi + 1 + positions.at i)
  limits := { depth := 100, states := 20000 }
