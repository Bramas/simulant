/-! Algorithm 6 of the black-hole-search paper (EBS Solution with 4 asynchronous agents and 2
pebbles): two pairs perform the cautious walk with a pebble (CautiousWalkPebble), and keep in
step by watching each other's public `dir` and `sync`. `dir` is a port index, which every
agent reads the same way under `Frames.identity`, so comparing it with another agent's `dir`
keeps its meaning.

`FourAgentsTwoPebblesLatency` reproduces the TypeScript simulation exactly: synchronous rounds,
with a pseudo-random number of idle rounds (the page shows the agent as idle) before each step
of the walk, to imitate asynchrony; its pseudo-random state never repeats, so it is explored to bounded depth.
`FourAgentsTwoPebbles` follows the same rules without the idling (a₃ and a₄ wait until a₁ and
a₂ have left), for exhaustive checks with synchronous and asynchronous agents. Both follow the
TypeScript's synchronisation rules, which differ from the paper's pseudocode (Procedure
CautiousWalkPebble waits until the other agent is on the same node; the pseudocode does not say
when an agent claims the hole, so the paper's version is not written here). -/

import "std/models.sim"

algorithm FourAgentsTwoPebbles uses otherStates, pebblesHere where
  Pub := { id : Nat, bh : Option Nat, dir : Nat, sync : Nat }
  output claim := pub.bh
  init i := { pub := { id := i, bh := none, dir := Port.cw, sync := 0 } }

  /-- CautiousWalkPebble, as the leader: probe with the pebble, turn around at a pebble or an agent. -/
  def lead (follower : Nat) :=
    repeat
      pub := { pub with sync := 1 }
      move (port pub.dir) with { pebble := .pick }
      if !otherStates.isEmpty ∨ pebblesHere > 0 then
        pub := { pub with dir := Port.opposite pub.dir, sync := 0 }
        move (port pub.dir)
        while otherStates.any (fun o => o.id = follower ∧ o.dir ≠ pub.dir)
          stay
      else
        move (port (Port.opposite pub.dir)) with { pebble := .drop }
        while otherStates.any (fun o => o.id = follower ∧ o.sync ≠ 1)
          stay
        pub := { pub with sync := 2 }
        move (port pub.dir)
        pub := { pub with bh := some (Port.opposite pub.dir) }
        while !(otherStates.any (fun o => o.id = follower ∧ (o.sync = 2 ∨ o.sync = 0)))
          stay
        pub := { pub with sync := 0 }
        while otherStates.any (fun o => o.id = follower ∧ o.sync = 2)
          stay

  /-- CautiousWalkPebble, as the follower. -/
  def follow (leader : Nat) :=
    repeat
      stay
      pub := { pub with bh := some pub.dir }
      while !(otherStates.any (fun o => o.id = leader ∧ (o.sync = 1 ∨ o.dir ≠ pub.dir)))
        stay
        pub := { pub with bh := some pub.dir }
      if otherStates.any (fun o => o.id = leader ∧ o.dir ≠ pub.dir) then
        pub := { pub with dir := Port.opposite pub.dir }
      else
        pub := { pub with sync := 2 }
        move (port pub.dir)
        pub := { pub with bh := some (Port.opposite pub.dir) }
        while !(otherStates.any (fun o => o.id = leader ∧ (o.sync = 2 ∨ o.sync = 0)))
          stay
        pub := { pub with sync := 0 }
        while otherStates.any (fun o => o.id = leader ∧ o.sync = 2)
          stay

  main :=
    if pub.id < 2 then
      move Ring.cw
      if pub.id = 0 then
        lead 1
      else
        follow 0
    else
      while otherStates.any (·.id < 2)
        stay
      if pub.id = 2 then
        lead 3
      else
        follow 2

algorithm FourAgentsTwoPebblesLatency uses otherStates, pebblesHere where
  Pub := { id : Nat, bh : Option Nat, dir : Nat, sync : Nat, seed : Nat }
  output claim := pub.bh
  init i := { pub := { id := i, bh := none, dir := Port.cw, sync := 0, seed := i + 49841 } }

  /-- Idle while the pseudo-random generator draws a multiple of `k`. -/
  def lag (k : Nat) :=
    pub := { pub with seed := pub.seed * 48271 % 2147483647 }
    while pub.seed % k = 0
      stay
      pub := { pub with seed := pub.seed * 48271 % 2147483647 }

  def lead (follower : Nat) (k : Nat) :=
    lag k
    repeat
      pub := { pub with sync := 1 }
      move (port pub.dir) with { pebble := .pick }
      lag k
      if !otherStates.isEmpty ∨ pebblesHere > 0 then
        pub := { pub with dir := Port.opposite pub.dir, sync := 0 }
        move (port pub.dir)
        lag k
        while otherStates.any (fun o => o.id = follower ∧ o.dir ≠ pub.dir)
          stay
          lag k
      else
        move (port (Port.opposite pub.dir)) with { pebble := .drop }
        lag k
        while otherStates.any (fun o => o.id = follower ∧ o.sync ≠ 1)
          stay
          lag k
        pub := { pub with sync := 2 }
        move (port pub.dir)
        lag k
        pub := { pub with bh := some (Port.opposite pub.dir) }
        while !(otherStates.any (fun o => o.id = follower ∧ (o.sync = 2 ∨ o.sync = 0)))
          stay
          lag k
        pub := { pub with sync := 0 }
        while otherStates.any (fun o => o.id = follower ∧ o.sync = 2)
          stay
          lag k

  def follow (leader : Nat) (k : Nat) :=
    lag k
    repeat
      stay
      lag k
      pub := { pub with bh := some pub.dir }
      while !(otherStates.any (fun o => o.id = leader ∧ (o.sync = 1 ∨ o.dir ≠ pub.dir)))
        stay
        lag k
        pub := { pub with bh := some pub.dir }
      if otherStates.any (fun o => o.id = leader ∧ o.dir ≠ pub.dir) then
        pub := { pub with dir := Port.opposite pub.dir }
      else
        pub := { pub with sync := 2 }
        move (port pub.dir)
        lag k
        pub := { pub with bh := some (Port.opposite pub.dir) }
        while !(otherStates.any (fun o => o.id = leader ∧ (o.sync = 2 ∨ o.sync = 0)))
          stay
          lag k
        pub := { pub with sync := 0 }
        while otherStates.any (fun o => o.id = leader ∧ o.sync = 2)
          stay
          lag k

  main :=
    if pub.id < 2 then
      move Ring.cw
      if pub.id = 0 then
        lead 1 3
      else
        follow 0 3
    else
      stay
      if pub.id = 2 then
        lead 3 5
      else
        follow 2 5

/-- The TypeScript simulation's version, with its pseudo-random idling. Its state space is
infinite: checks stop at the state limit. -/
experiment algo6 where
  model := blackHoleRobots (Graphs.Cycle N) .mayEmerge .unknown (extra := [Storage.Pebbles])
  algorithm := FourAgentsTwoPebblesLatency
  task := IdentifyEmergingBlackHole
  param N : Nat in (range 13).filter (· ≥ 5)
  param site : Pos in positions
  agents := 4
  position i := pos 0
  limits := { states := 100000 }

/-- The same rules without the idling, in synchronous rounds: checked exhaustively. -/
experiment algo6Sync where
  model := blackHoleRobots (Graphs.Cycle N) .mayEmerge .unknown (extra := [Storage.Pebbles])
  algorithm := FourAgentsTwoPebbles
  task := IdentifyEmergingBlackHole
  param N : Nat in (range 13).filter (· ≥ 5)
  param site : Pos in positions
  agents := 4
  position i := pos 0

/-- The same rules with asynchronous agents (the semi-synchronous round: the adversary activates
any agents, each infinitely often), the hole anywhere but on the starting node (with
asynchronous agents, a hole that emerges there before anyone leaves destroys every agent,
whatever the algorithm). The check finds an execution in which a leader and its follower,
on different nodes, wait for each other forever (N = 5, hole at 3): these rules let a leader
go on when its follower is not on its node, where the paper's pseudocode waits for it. -/
experiment algo6Async where
  model := blackHoleRobots (Graphs.Cycle N) .mayEmerge .unknown (extra := [Storage.Pebbles]) (round := .ssync)
  algorithm := FourAgentsTwoPebbles
  task := IdentifyEmergingBlackHole
  param N : Nat in (range 13).filter (· ≥ 5)
  param site : Pos in positions.filter (· ≠ pos 0)
  agents := 4
  position i := pos 0
