/-! Algorithm 1 of the black-hole-search paper (Four-Agent EBS Solution,
`latex-algo/algorithm-1-2e.tex`): two pairs of agents perform cautious walks.
Migrated from `src/simulations/algo1.ts` (plan, Phase 4). -/

import "std/models.sim"
import "std/tasks.sim"

algorithm FourAgentEBS uses otherStates where
  Pub := { id : Nat, bh : Option Move }
  output claim := pub.bh
  init i := { pub := { id := i, bh := none } }

  /-- CautiousWalk(leader, follower, direction): the leader probes the next node and comes
  back; the follower waits, and declares the hole if the leader does not come back. -/
  def cautiousWalk (leader : Nat) (follower : Nat) (dir : Move) :=
    if pub.id = leader then
      repeat
        move dir
        move dir.opposite
        move dir
    else
      repeat
        stay
        stay
        if !(otherStates.any (·.id = leader)) then
          pub := { pub with bh := some dir }
          halt
        move dir

  main :=
    if pub.id = 0 ∨ pub.id = 1 then
      move .cw
      cautiousWalk 0 1 .cw
    else
      move .ccw
      cautiousWalk 2 3 .cw

/-- The settings of the paper's checks: rings of 5 to 12 nodes, the hole anywhere. -/
experiment algo1 where
  model := blackHoleRing .mayEmerge .unknown
  algorithm := FourAgentEBS
  task := IdentifyEmergingBlackHole
  param N : Nat := (range 13).filter (· ≥ 5)
  param site : Node := (range N).map node
  agents := 4
  position i := node 0
