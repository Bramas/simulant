/-! Algorithm 0 of the black-hole-search paper (Small Rings): on a cycle of 2 nodes, the agents
find out from who they meet, and identify the hole there; otherwise a₁, a₂ and a₃ run
Algorithm 4, and a₄ waits. Its Algorithm 4 differs slightly from `algo4`: a₁ and a₃ have
already moved, and a₂ does not wait first.

The 2-node setting is `Graphs.Cycle 2`, whose two ports at each vertex both lead to the other
vertex. -/

import "std/models.sim"

algorithm SmallRings uses otherStates where
  Pub := { id : Nat, foundN : Bool, bhPort : Option Nat, bhSteps : Nat }
  output claimPort := pub.bhPort
  output claimSteps := pub.bhSteps
  init i := { pub := { id := i, foundN := false, bhPort := none, bhSteps := 0 } }

  def lead (dir : Nat) :=
    repeat
      move (port dir)
      move (port (Port.opposite dir))
      move (port dir)

  def follow (leader : Nat) (dir : Nat) :=
    repeat
      stay
      stay
      if !(otherStates.any (·.id = leader)) then
        pub := { pub with bhPort := some dir, bhSteps := 1 }
        halt
      move (port dir)

  /-- Algorithm 4 as agent a₁. -/
  def asA1 :=
    let rl : Nat := 1
    repeat
      if !otherStates.isEmpty then
        lead Port.ccw
      move Ring.ccw
      wait rl - 1
      if !otherStates.isEmpty then
        pub := { pub with foundN := true }
      wait rl - 1
      move Ring.cw
      stay
      if otherStates.isEmpty then
        pub := { pub with bhPort := some Port.cw, bhSteps := 1 }
        halt
      stay
      stay
      if !pub.foundN then
        rl := rl + 1

  /-- Algorithm 4 as agent a₂. -/
  def asA2 :=
    let rl : Nat := 1
    repeat
      wait 2 * rl
      move Ring.ccw
      if otherStates.isEmpty then
        pub := { pub with bhPort := some Port.ccw, bhSteps := 2 }
        move Ring.cw
        halt
      if otherStates.any (·.foundN) then
        pub := { pub with foundN := true }
      move Ring.cw
      if otherStates.isEmpty then
        move Ring.ccw
        follow 0 Port.ccw
      stay
      if !pub.foundN then
        rl := rl + 1

  /-- Algorithm 4 as agent a₃. -/
  def asA3 :=
    let rl : Nat := 1
    let k : Nat := 0
    repeat
      k := 0
      while k + 1 < rl
        k := k + 1
        move Ring.cw
      stay
      if !otherStates.isEmpty then
        pub := { pub with foundN := true }
      stay
      k := 0
      while k + 1 < rl
        k := k + 1
        move Ring.ccw
      move Ring.ccw
      stay
      if otherStates.isEmpty then
        pub := { pub with bhPort := some Port.ccw, bhSteps := 1 }
        halt
      if otherStates.any (·.bhPort.isSome) then
        -- Adopt the claim of an agent here (it is on the same node and ports are common, so it
        -- holds for me too); if several differ, the counterclockwise one first, then the
        -- farthest, whatever their order.
        let ccw := otherStates.any (·.bhPort = some Port.ccw)
        let far := otherStates.any (fun o => o.bhPort = some Port.ccw ∧ o.bhSteps = 2)
        pub := { pub with bhPort := some (if ccw then Port.ccw else Port.cw), bhSteps := if far then 2 else 1 }
        halt
      move Ring.cw
      if !pub.foundN then
        rl := rl + 1

  main :=
    let collocated : Nat := 0
    if pub.id = 0 then
      move Ring.ccw
      -- Meeting a₃ alone: the cycle has 2 nodes.
      if otherStates.length = 1 then
        pub := { pub with foundN := true }
        repeat
          move Ring.ccw
      stay
      asA1
    else if pub.id = 1 then
      stay
      collocated := otherStates.length
      stay
      if otherStates.length > collocated then
        stay
        repeat
          stay
          if otherStates.length = collocated then
            -- On 2 nodes, the hole is the other node.
            pub := { pub with bhPort := some Port.cw, bhSteps := 1 }
            halt
          stay
      asA2
    else if pub.id = 2 then
      move Ring.cw
      if otherStates.length = 1 then
        pub := { pub with foundN := true }
        stay
        repeat
          stay
          if otherStates.isEmpty then
            pub := { pub with bhPort := some Port.cw, bhSteps := 1 }
            halt
          stay
      stay
      asA3
    else
      halt

/-- The settings of the paper's checks: cycles of 2 to 4 nodes, the hole anywhere. -/
experiment algo0 where
  model := blackHoleSearch (Graphs.Cycle N) .mayEmerge .unknown
  algorithm := SmallRings
  task := IdentifyEmergingBlackHoleAt
  param N : Nat in (range 5).filter (· ≥ 2)
  param site : Pos in positions
  agents := 4
  position i := pos 0
  -- When an agent disappears before a₁ and a₃ meet, their exploration limit grows forever:
  -- the state space is infinite, and checks explore at most this many states.
  limits := { states := 100000 }
