/-! P06: Bramas, Kamei, Lamani and Tixeuil, Stand-Up Indulgent Gathering on Rings.
arXiv:2402.14233v1, section 3: the positive two-robot FSYNC strategy.
Full occupancy, no multiplicity detection, no memory or chirality.
The admitted starts are non-periodic node-node symmetric pairs on even cycles.
Only this positive rendezvous case is translated, not the general SUIG algorithm. -/

import "std/models.sim"

/-- Normalized two-robot starts: both arcs have distinct positive even lengths. -/
def admittedPair (n : Nat) (offset : Nat) : Bool :=
  n ≥ 6 ∧ n % 2 = 0 ∧ offset > 0 ∧ offset < n ∧
    offset % 2 = 0 ∧ 2 * offset ≠ n

/-- Both bodies, including a crashed one, must remain co-located.
The algorithm stays once only one occupied node remains, so success is closed. -/
@[equivariant]
task StandUpRendezvous (C : Config) : Verdict :=
  if C.agents.all (fun a => C.agents.all (fun b => a.pos = b.pos))
  then .success else .inProgress

goal StandUpRendezvous := eventually always .success

/-- Section 3's shortest-path strategy. The other occupied node is unique.
A tie can occur outside the admitted starts; staying makes that extension explicit. -/
algorithm ShortestPathRendezvous uses occupied where
  init i := {}
  main :=
    let others := visible.filter fun l => l ≠ here ∧ occupied l
    if others.length = 1 then
      let target := others.at 0
      let toward := (neighbors here).filter fun l =>
        distance l target + 1 = distance here target
      if toward.length = 1 then
        move (toward.at 0)
      else
        stay
    else
      stay

experiment twoRobotFSync where
  model := obliviousRobots (Graphs.Cycle N) Observe.full Frames.isomorphisms
    [occupied] (components := [Faults.CrashStop 1])
  algorithm := ShortestPathRendezvous
  task := StandUpRendezvous
  param N : Nat where N ≥ 6 ∧ N % 2 = 0
  param offset : Nat where admittedPair N offset
  agents := 2
  position i := if i = 0 then pos 0 else pos offset
