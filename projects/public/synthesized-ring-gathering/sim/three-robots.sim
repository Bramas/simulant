/-! P04: Millet et al., On the Synthesis of Mobile Robots Algorithms:
the Case of Ring Gathering, arXiv:1407.0978v2, section 4.
Three oblivious FSYNC robots with full multiplicity observations and no chirality.
Two experiments distinguish the strategy description from the final rule paragraph:
the latter omits the isolated robot's move from an antipodal two-robot tower. -/

import "std/models.sim"

/-- Theorem 9's initial domain, including towers but excluding periodic configurations. -/
def admittedTriple (n : Nat) (ps : List Nat) : Bool :=
  if ps.length ≠ 3 then false else
    n > 3 ∧ ps.all (fun p => p < n) ∧
    (range 3).all (fun i => i = 0 ∨ ps.at (i - 1) ≤ ps.at i) ∧
    !(range n).any (fun shift => shift > 0 ∧
      (range n).all (fun p =>
        ps.count (fun q => q = p) = ps.count (fun q => q = (p + shift) % n)))

/-- Offset in the full observed cycle, rooted at here and oriented by the first port.
This uses only the visible graph's distances; physical vertex numbers are inaccessible. -/
def rootOffset (l : Loc) : Nat :=
  let d := distance here l
  if l = here then 0
  else if distance (port 0) l + 1 = d then d
  else visible.length - d

def locationAt (i : Nat) : Loc :=
  (visible.filter fun l => rootOffset l = i).at 0

/-- Section 4's movement cases. When towerTie is true, the preceding strategy bullet
supplies the disoriented-tower move missing from the final paragraph's strict y<z guard. -/
def destination (towerTie : Bool) : Loc :=
  if count here > 1 then here else
    let others := visible.filter fun l => l ≠ here ∧ count l > 0
    if others.length = 1 then
      let target := others.at 0
      let toward := (neighbors here).filter fun l =>
        distance l target + 1 = distance here target
      if toward.length = 1 then toward.at 0
      else if towerTie ∧ toward.length = 2 then toward.at 0
      else here
    else if others.length = 2 then
      let offsets := (range visible.length).filter fun i => i > 0 ∧ count (locationAt i) > 0
      let a := offsets.at 0
      let b := offsets.at 1
      -- Forward gap view (x,y,z): free nodes, hence adjacency has gap 0.
      let x := a - 1
      let y := b - a - 1
      let z := visible.length - b - 1
      -- (x,x,z), x<z: move to decrease the first gap.
      if x = y ∧ y < z then port 0
      else if z = y ∧ y < x then port 1
      -- (z,x,z), x<z: either direction, provided by the reflected Look.
      else if x = z ∧ y < x then port 0
      -- Rigid cases (x,y,z), x<y<z, and (y,x,z), x<y<z.
      else if x < y ∧ y < z then port 0
      else if z < y ∧ y < x then port 1
      else if y < x ∧ x < z then port 0
      else if y < z ∧ z < x then port 1
      else here
    else here

algorithm StrategyDescription uses count where
  init i := {}
  main :=
    move (destination true)

algorithm FinalParagraph uses count where
  init i := {}
  main :=
    move (destination false)

@[equivariant]
task StableThreeGathering (C : Config) : Verdict :=
  if C.agents.all (fun a => C.agents.all (fun b => a.pos = b.pos))
  then .success else .inProgress

goal StableThreeGathering := eventually always .success

experiment threeRobotFSync where
  model := obliviousRobots (Graphs.Cycle N) Observe.full Frames.isomorphisms [count]
  algorithm := StrategyDescription
  task := StableThreeGathering
  param N : Nat where N > 3
  param positions : List Nat where admittedTriple N positions
  agents := 3
  position i := pos (positions.at i)

experiment literalFinalParagraph where
  model := obliviousRobots (Graphs.Cycle N) Observe.full Frames.isomorphisms [count]
  algorithm := FinalParagraph
  task := StableThreeGathering
  param N : Nat where N > 3
  param positions : List Nat where admittedTriple N positions
  agents := 3
  position i := pos (positions.at i)
