{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["vite/client"],
    "noEmit": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@bramas/simulant-core/*": ["../../../packages/core/src/*"],
      "@bramas/simulant-ui/*": ["../../../packages/simulator-ui/src/*"]
    }
  },
  "include": ["src", "../index.ts", "../../../packages/core/src", "../../../packages/simulator-ui/src"]
}
