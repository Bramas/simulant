{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "noEmit": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@bramas/simulant-core/*": [
        "packages/core/src/*"
      ],
      "@bramas/simulant-ui/*": [
        "packages/simulator-ui/src/*"
      ]
    },
    "allowJs": true
  }
}
