{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "noEmit": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@bramas/simulant-core/*": [
        "packages/core/src/*"
      ],
      "@bramas/simulant-ui/*": [
        "packages/simulator-ui/src/*"
      ],
      "@bramas/simulant-lang/*": [
        "packages/lang/src/*"
      ],
      "@bramas/simulant-engine/*": [
        "packages/engine/src/*"
      ],
      "@bramas/simulant-lean-gen/*": [
        "packages/lean-gen/src/*"
      ],
      "@bramas/simulant-vite-plugin": [
        "packages/vite-plugin/src/index.ts"
      ],
      "@bramas/simulant-vite-plugin/*": [
        "packages/vite-plugin/src/*"
      ]
    },
    "allowJs": true
  }
}
